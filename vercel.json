{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/summarize.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/validate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/ocr.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/convert-image.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/compress-image.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/summarize(.*)",
      "dest": "api/summarize.py"
    },
    {
      "src": "/api/validate(.*)",
      "dest": "api/validate.py"
    },
    {
      "src": "/api/ocr(.*)",
      "dest": "api/ocr.py"
    },
    {
      "src": "/api/convert-image(.*)",
      "dest": "api/convert-image.py"
    },
    {
      "src": "/api/compress-image(.*)",
      "dest": "api/compress-image.py"
    },
    {
      "src": "/hawas/(.*)",
      "dest": "public/hawas/$1"
    },
    {
      "src": "/hawas",
      "dest": "public/hawas/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
